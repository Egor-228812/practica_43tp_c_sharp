<Window x:Class="Petrov_Tema_14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Petrov_Tema_14"
        Title="Система бронирования отеля" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:AvailabilityToColorConverter x:Key="AvailabilityToColorConverter"/>
        <local:AvailabilityToStatusConverter x:Key="AvailabilityToStatusConverter"/>

        <DataTemplate x:Key="RoomCardTemplate">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Margin="5"
                    Background="{Binding IsAvailable, Converter={StaticResource AvailabilityToColorConverter}}">
                <StackPanel Margin="10">
                    <TextBlock FontWeight="Bold" FontSize="14">
                        <Run Text="Номер "/><Run Text="{Binding Number}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Type}" Margin="0,5"/>
                    <TextBlock>
                        <Run Text="Цена: "/><Run Text="{Binding PricePerNight}"/><Run Text=" руб./ночь"/>
                    </TextBlock>
                    <TextBlock>
                        <Run Text="Статус: "/>
                        <Run Text="{Binding IsAvailable, Converter={StaticResource AvailabilityToStatusConverter}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="BookButtonTemplate" TargetType="Button">
            <Border x:Name="border" CornerRadius="5" Background="Green" BorderBrush="DarkGreen" BorderThickness="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,5"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="LightGreen"/>
                    <Setter TargetName="border" Property="BorderBrush" Value="ForestGreen"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="DarkGreen"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Background" Value="Gray"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddBookingCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditBookingCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding CancelBookingCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Номера">
                <MenuItem Header="Список номеров" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Обновить статус" Click="RefreshRooms_Click"/>
            </MenuItem>
            <MenuItem Header="_Бронирование">
                <MenuItem Header="_Добавить" Command="{Binding AddBookingCommand}" InputGestureText="Ctrl+N"/>
                <MenuItem Header="_Редактировать" Command="{Binding EditBookingCommand}" InputGestureText="Ctrl+E"/>
                <MenuItem Header="_Отменить" Command="{Binding CancelBookingCommand}" InputGestureText="Del"/>
            </MenuItem>
            <MenuItem Header="_Настройки">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Command="{Binding AddBookingCommand}" Content="Забронировать" 
                    Template="{StaticResource BookButtonTemplate}" ToolTip="Ctrl+N"/>
            <Button Command="{Binding EditBookingCommand}" Content="Редактировать" ToolTip="Ctrl+E"/>
            <Button Command="{Binding CancelBookingCommand}" Content="Отменить" ToolTip="Del"/>
        </ToolBar>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="roomsListBox" Grid.Column="0" 
                     ItemsSource="{Binding Rooms}" 
                     ItemTemplate="{StaticResource RoomCardTemplate}"
                     SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                     Margin="0,0,5,0"/>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <GroupBox Header="Бронирование" Margin="0,0,0,10">
                    <StackPanel>
                        <Label Content="ФИО"/>
                        <TextBox Text="{Binding CurrentBooking.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        <Label Content="Контакты"/>
                        <TextBox Text="{Binding CurrentBooking.Contacts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,5"/>
                        <Label Content="Дата заезда"/>
                        <DatePicker SelectedDate="{Binding CurrentBooking.CheckInDate, Mode=TwoWay}" Margin="0,5"/>
                        <Label Content="Дата выезда"/>
                        <DatePicker SelectedDate="{Binding CurrentBooking.CheckOutDate, Mode=TwoWay}" Margin="0,5"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Список бронирований" Margin="0,10,0,0">
                    <DataGrid x:Name="bookingsGrid" 
                              ItemsSource="{Binding Bookings}" 
                              AutoGenerateColumns="True" IsReadOnly="True"
                              SelectedItem="{Binding SelectedBooking, Mode=TwoWay}"
                              Height="200"/>
                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>