<Window x:Class="Petrov_Tema_14.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Petrov_Tema_14"
        Title="Система бронирования отеля" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:AvailabilityToColorConverter x:Key="AvailabilityToColorConverter"/>
        <local:AvailabilityToStatusConverter x:Key="AvailabilityToStatusConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <local:HotelViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0" Height="20" IsIndeterminate="True"
                     Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Margin="0,0,5,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="3"
                                Background="{Binding IsAvailable, Converter={StaticResource AvailabilityToColorConverter}}">
                            <StackPanel Margin="5">
                                <TextBlock FontWeight="Bold" Text="{Binding Number}"/>
                                <TextBlock Text="{Binding Type}"/>
                                <TextBlock Text="{Binding PricePerNight, StringFormat=Цена: {0} руб./ночь}"/>
                                <TextBlock Text="{Binding IsAvailable, Converter={StaticResource AvailabilityToStatusConverter}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <GroupBox Header="Бронирование">
                    <StackPanel>
                        <Label Content="ФИО"/>
                        <TextBox Text="{Binding CurrentBooking.CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Контакты"/>
                        <TextBox Text="{Binding CurrentBooking.Contacts, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Дата заезда"/>
                        <DatePicker SelectedDate="{Binding CurrentBooking.CheckInDate}"/>
                        <Label Content="Дата выезда"/>
                        <DatePicker SelectedDate="{Binding CurrentBooking.CheckOutDate}"/>
                        <Button Content="Забронировать" Command="{Binding BookCommand}" Margin="0,10,0,0"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="Отменить бронь" Command="{Binding CancelBookingCommand}" Margin="0,5,0,0"
                                IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Список бронирований" Margin="0,10,0,0">
                    <ListView ItemsSource="{Binding Bookings}" Height="200">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding CustomerName}"/>
                                    <TextBlock Text="{Binding RoomNumber, StringFormat=Номер: {0}}"/>
                                    <TextBlock Text="{Binding CheckInDate, StringFormat=с {0:dd.MM.yyyy}}"/>
                                    <TextBlock Text="{Binding CheckOutDate, StringFormat=по {0:dd.MM.yyyy}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>