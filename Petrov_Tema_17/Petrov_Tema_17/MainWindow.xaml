<Window x:Class="Petrov_Tema_17.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Petrov_Tema_17"
        Title="Система бронирования отеля" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BookingStatusConverter x:Key="BookingStatusConverter"/>
        <local:StatusColorConverter x:Key="StatusColorConverter"/>

        <Storyboard x:Key="ScaleFadeInAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1" Duration="0:0:0.4"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1" Duration="0:0:0.4"/>
        </Storyboard>

        <Storyboard x:Key="BookedBorderAnimation" RepeatBehavior="Forever" AutoReverse="True">
            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                            From="#FFD32F2F" To="#FFFF6B6B" Duration="0:0:0.6"/>
        </Storyboard>

        <Storyboard x:Key="ShowDetailsAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-20,0,0" To="0,0,0,0" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="HideDetailsAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="RoomBorder" BorderThickness="2" CornerRadius="8" Background="White" Margin="5" Padding="10"
                                BorderBrush="LightGray" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding RoomNumber}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Price, StringFormat={}{0} BYN}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding IsBooked, Converter={StaticResource BookingStatusConverter}}" FontSize="11"
                                               Foreground="{Binding IsBooked, Converter={StaticResource StatusColorConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RoomBorder" Property="Background" Value="#FFF0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F5F5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320*"/>
            <ColumnDefinition Width="33*"/>
            <ColumnDefinition Width="447*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="RoomsListBox" Grid.Column="0" Margin="10,10,10,10" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource ListBoxItemStyle}" SelectionChanged="RoomsListBox_SelectionChanged"/>

        <Border x:Name="DetailsPanel" Grid.Column="1" Margin="10,10,10,10" Background="White" CornerRadius="10"
                Opacity="0" Visibility="Collapsed" BorderBrush="#DDD" BorderThickness="1" Grid.ColumnSpan="2">
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <StackPanel Margin="20" VerticalAlignment="Top">
                <TextBlock Text="Детали номера" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>
                <StackPanel x:Name="DetailsContent" Opacity="0">
                    <TextBlock x:Name="DetailRoomNumber" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DetailType" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DetailPrice" FontSize="14" Margin="0,0,0,5"/>
                    <TextBlock x:Name="DetailStatus" FontSize="14" Margin="0,0,0,20"/>
                    <Button x:Name="BookingButton" Content="Забронировать" Background="#4CAF50" Foreground="White"
                            FontSize="14" Padding="10,5" BorderThickness="0" Cursor="Hand" Click="BookingButton_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>