<Window x:Class="Petrov_Tema_18.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Petrov_Tema_18.ViewModels"
        xmlns:conv="clr-namespace:Petrov_Tema_18.Converters"
        mc:Ignorable="d"
        Title="Система бронирования отеля" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <conv:BookingStatusConverter x:Key="BookingStatusConverter"/>
        <conv:StatusColorConverter x:Key="StatusColorConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Доступные номера" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
        <ListView Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Margin="0,5,10,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Padding="10" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                <TextBlock Text="{Binding RoomNumber}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Type}" FontSize="12" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Price, StringFormat={}{0} BYN}" FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding IsBooked, Converter={StaticResource BookingStatusConverter}}" FontSize="11"
                                           Foreground="{Binding IsBooked, Converter={StaticResource StatusColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Текущие бронирования" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
        <DataGrid Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,5,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Клиент" Binding="{Binding CustomerName}" Width="*"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Room.RoomNumber}" Width="Auto"/>
                <DataGridTextColumn Header="Заезд" Binding="{Binding CheckInDate, StringFormat=d}" Width="Auto"/>
                <DataGridTextColumn Header="Выезд" Binding="{Binding CheckOutDate, StringFormat=d}" Width="Auto"/>
                <DataGridCheckBoxColumn Header="Активно" Binding="{Binding IsActive}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#F0F0F0" CornerRadius="10" Padding="10" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Клиент:" VerticalAlignment="Center" Margin="5"/>
                <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="5"/>
                <TextBlock Text="Заезд:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker SelectedDate="{Binding CheckInDate}" Width="110" Margin="5"/>
                <TextBlock Text="Выезд:" VerticalAlignment="Center" Margin="5"/>
                <DatePicker SelectedDate="{Binding CheckOutDate}" Width="110" Margin="5"/>
                <Button Content="Забронировать" Command="{Binding BookRoomCommand}" Background="#4CAF50" Foreground="White" Padding="10,5" Margin="10,0,0,0"/>
                <Button Content="Отменить бронь" Command="{Binding CancelBookingCommand}" Background="#F44336" Foreground="White" Padding="10,5" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>