@model Petrov_Tema_19.Models.Contact

@{
    ViewData["Title"] = "Удаление контакта";
}

<h2>Удаление контакта</h2>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить этот контакт?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Имя</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        <dt class="col-sm-2">Телефон</dt>
        <dd class="col-sm-10">@Model.PhoneNumber</dd>
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>